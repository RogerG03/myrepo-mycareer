---
import type { Locale } from "../i18n/ui";
const { lang } = Astro.props as { lang: Locale };
const es = lang === "es";
---

<figure class="code-scene" aria-label={es ? "Composición ilustrativa: del código a una interfaz, con paneles en perspectiva y un núcleo de luz azul" : "Illustrative composition: from code to interface, with perspective panels and a blue light core"}>
  <div class="scene-space" aria-hidden="true" data-ui>
    <div class="light-core"><div class="core-mesh"><svg viewBox="0 0 320 320"><circle cx="160" cy="160" r="148" />{[30, 65, 105, 145].map(width => <ellipse cx="160" cy="160" rx={width} ry="148" />)}{[45, 85, 120].map(height => <ellipse cx="160" cy="160" rx="148" ry={height} />)}</svg></div></div>
    <div class="code-window source-window">
      <div class="window-bar"><span class="window-dots">● ● ●</span><span>interface.tsx</span><span>↗</span></div>
      <pre><code><span class="dim">// {es ? "Hacer claro lo complejo" : "Make complexity clear"}</span>{"\n"}<span class="keyword">export function</span> <span class="function">Interface</span>() {"{"}{"\n"}  <span class="keyword">return</span> ({"\n"}    &lt;<span class="function">Workflow</span>{"\n"}      <span class="property">context</span>={"{"}requirements{"}"}{"\n"}      <span class="property">components</span>={"{"}sharedUI{"}"}{"\n"}      <span class="property">accessible</span>{"\n"}    /&gt;{"\n"}  );{"\n"}{"}"}</code></pre>
      <div class="window-foot"><span>TypeScript / React</span><span>UTF-8</span></div>
    </div>
    <div class="code-window result-window">
      <div class="window-bar"><span class="window-dots">● ● ●</span><span>{es ? "Vista de interfaz" : "Interface preview"}</span><span>↗</span></div>
      <div class="result-content"><span class="preview-label">{es ? "Del flujo al producto" : "From flow to product"}</span><strong>{es ? "Todo empieza" : "It all starts"}<br />{es ? "con claridad." : "with clarity."}</strong><div class="preview-flow"><span>{es ? "Analizar" : "Analyze"}</span><span>→</span><span>{es ? "Construir" : "Build"}</span><span>→</span><span>{es ? "Validar" : "Validate"}</span></div><div class="preview-component"><span class="component-symbol">&lt;/&gt;</span><div><b>{es ? "Una interfaz compartida" : "A shared interface"}</b><small>{es ? "Componentes que conectan el sistema" : "Components that connect the system"}</small></div></div></div>
    </div>
    <div class="scene-coordinate"><span>React · TypeScript · Astro</span><span>&lt;/&gt;</span></div>
  </div>
  <figcaption>{es ? "Del requerimiento a la experiencia. Una representación de mi proceso." : "From requirement to experience. An illustration of my process."}</figcaption>
</figure>

<style>
  .code-scene{margin:0;min-width:0}.scene-space{position:relative;height:440px;perspective:1100px;isolation:isolate}
  .light-core{position:absolute;width:300px;height:300px;left:40%;top:12%;border-radius:50%;background:radial-gradient(circle at 32% 26%,#a6e9ff 0%,#62b8ed 5%,#256dd3 30%,#124caa 55%,#071a35 76%);box-shadow:0 0 100px #256dd344,inset -24px -18px 45px #020b24;transform:rotate(-25deg)}
  .core-mesh{position:absolute;inset:0;border-radius:50%;overflow:hidden}.core-mesh svg{width:100%;height:100%;fill:none;stroke:#c3ebff;stroke-width:.55;opacity:.4}
  .code-window{position:absolute;overflow:hidden;border:1px solid #62b8ed40;border-radius:12px;background:#0a1d36f5;color:#eaf3ff;box-shadow:0 25px 55px #020a1890;transform-style:preserve-3d}
  .source-window{width:340px;left:0;top:20px;transform:rotateY(14deg) rotateX(6deg) rotateZ(-7deg)}
  .window-bar,.window-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;color:#b5c9e1;font-size:11px;background:#112b5255}.window-dots{color:#62b8ed;font-size:8px;letter-spacing:3px}.window-foot{padding-block:10px;font-size:10px}
  pre{margin:0;padding:24px 20px;font:12px/1.9 Consolas,monospace;white-space:pre}.dim{color:#99b0ca}.keyword{color:#87b7ff}.function{color:#9ee4ff}.property{color:#c3dbed}
  .result-window{width:310px;right:0;top:150px;transform:rotateY(-16deg) rotateX(7deg) rotateZ(5deg);background:#102b4a}
  .result-content{padding:24px}.preview-label{color:#b8d1e9;font-size:11px}.result-content>strong{display:block;margin:14px 0 20px;font-size:32px;line-height:1.02;letter-spacing:-.05em;font-weight:500}.preview-flow{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:10px;color:#b9dcff}.preview-flow span:nth-child(even){color:#62b8ed}.preview-component{display:flex;align-items:center;gap:12px;margin-top:24px;padding:15px 10px;background:#173d60}.component-symbol{color:#8ed4ff;font-size:23px}.preview-component b,.preview-component small{display:block;font-size:10px;font-weight:400}.preview-component small{margin-top:5px;font-size:8px;color:#bad0e3}
  .scene-coordinate{position:absolute;bottom:8px;left:18px;right:10px;display:flex;justify-content:space-between;font-size:12px;color:#a6c1dc}.scene-coordinate>span+span{color:#62b8ed}figcaption{max-width:46ch;margin:16px 0 0 18px;color:var(--muted);font-size:13px;line-height:1.5}
  @media(prefers-reduced-motion:no-preference){.source-window{animation:assemble-source 1.1s cubic-bezier(.16,1,.3,1) both}.result-window{animation:assemble-result 1.3s cubic-bezier(.16,1,.3,1) both}.light-core{animation:core-enter 1.5s ease-out both}}
  @keyframes assemble-source{from{opacity:0;transform:translate3d(-35px,25px,-100px) rotateY(22deg) rotateZ(-12deg)}}
  @keyframes assemble-result{from{opacity:0;transform:translate3d(35px,45px,-100px) rotateY(-25deg) rotateZ(12deg)}}
  @keyframes core-enter{from{opacity:0;transform:scale(.86) rotate(-25deg)}}
  @media(max-width:360px){.light-core{left:auto!important;right:10px;transform:none;width:70%!important;height:auto!important;aspect-ratio:1}.result-window{width:225px!important}.preview-flow{font-size:9px}}
  @media(max-width:1100px) and (min-width:821px){.source-window{width:290px}.result-window{width:270px;top:175px}.result-content{padding:20px}.light-core{left:30%;width:260px;height:260px}}
  @media(max-width:600px){.scene-space{height:385px}.source-window{width:260px;left:0;top:0;transform:rotateY(10deg) rotateZ(-5deg)}.source-window pre{font-size:10px;padding:18px}.result-window{width:245px;right:0;top:150px;transform:rotateY(-10deg) rotateZ(4deg)}.result-content{padding:18px}.result-content>strong{font-size:27px}.preview-component{margin-top:15px}.light-core{width:220px;height:220px;left:30%;top:12%}.scene-coordinate{bottom:0;font-size:10px}figcaption{margin-left:0}.window-bar{padding:12px;font-size:10px}}
</style>
