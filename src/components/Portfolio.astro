---
import "@fontsource-variable/chivo";
import { siAnthropic, siAstro, siClaude, siCss, siGit, siGithub, siHtml5, siJavascript, siLanguagetool, siReact, siTypescript, siVitest, siWordpress } from "simple-icons";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui, type Locale } from "../i18n/ui";

const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];
const alternateLang = lang === "es" ? "en" : "es";
const alternateLocaleUrl = getRelativeLocaleUrl(alternateLang);
const demo = lang === "es"
  ? { syllabusLabel: "Representación ilustrativa del flujo de creación de un sílabo", appName: "Rental OS", cycle: "Ciclo académico", analytic: "Plan analítico", thematic: "Plan temático", unit: "Unidad de aprendizaje", definition: "Definición de simulación", objectives: "Objetivos", contents: "Contenidos", sessions: "Encuentros", rentalLabel: "Representación ilustrativa de una vista móvil de software de renta de vehículos", nextTrip: "Tu próximo recorrido", rentClear: "Renta con claridad.", customers: "Clientes", rentals: "Rentas", cars: "Autos", activeBooking: "Reserva activa", customerFlow: "Flujo de cliente y vehículo", active: "Activa", availability: "Disponibilidad", lookup: "Consulta y filtrado", ready: "Lista", journeyLabel: "Simulación ilustrativa de un recorrido de usuario", experience: "Experiencia de usuario", clearRoute: "Ruta clara", access: "Acceso", entry: "Entrada sin fricción", questionnaire: "Cuestionario", progress: "Progreso comprensible", result: "Resultado", actionable: "Información accionable", content: "Contenido", continuity: "Continuidad del recorrido", footer: "La interfaz orienta. El flujo hace el resto." }
  : { syllabusLabel: "Illustrated representation of the syllabus creation flow", appName: "Rental OS", cycle: "Academic cycle", analytic: "Analytical plan", thematic: "Thematic plan", unit: "Learning unit", definition: "Simulation definition", objectives: "Objectives", contents: "Contents", sessions: "Sessions", rentalLabel: "Illustrated representation of a car-rental software mobile view", nextTrip: "Your next trip", rentClear: "Rent with clarity.", customers: "Customers", rentals: "Rentals", cars: "Cars", activeBooking: "Active booking", customerFlow: "Customer and vehicle flow", active: "Active", availability: "Availability", lookup: "Search and filtering", ready: "Ready", journeyLabel: "Illustrated simulation of a user journey", experience: "User experience", clearRoute: "Clear route", access: "Access", entry: "Friction-free entry", questionnaire: "Questionnaire", progress: "Understandable progress", result: "Result", actionable: "Actionable information", content: "Content", continuity: "Journey continuity", footer: "The interface guides. The flow does the rest." };

const github = "https://github.com/RogerG03";
const linkedin = "https://www.linkedin.com/in/roger-0113-guido";
const site = Astro.site?.toString().replace(/\/$/, "");
const canonicalUrl = site ? new URL(Astro.url.pathname, site).href : undefined;
const alternateUrl = site ? new URL(alternateLocaleUrl, site).href : undefined;
const personSchema = { "@context": "https://schema.org", "@type": "Person", name: "Roger Fernando Guido Cisneros", jobTitle: "Frontend Developer", description: t.description, sameAs: [github, linkedin], ...(canonicalUrl ? { url: canonicalUrl } : {}) };
const linkedinIcon = { path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.94v5.666H9.35V8.999h3.414v1.561h.047c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.369 4.267 5.455v6.287zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V8.999h3.564v11.453zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z", hex: "0A66C2" };
const technologies = [{ name: "Astro", icon: siAstro }, { name: "React", icon: siReact }, { name: "JavaScript", icon: siJavascript }, { name: "TypeScript", icon: siTypescript }, { name: "HTML", icon: siHtml5 }, { name: "CSS", icon: siCss }, { name: "Git", icon: siGit }, { name: "WordPress", icon: siWordpress }, { name: "i18n", icon: siLanguagetool }, { name: t.technology.testing, icon: siVitest }, { name: "Prompts", icon: siClaude }, { name: "Agentes", icon: siAnthropic }];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f6f9ff" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alternateUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <title>{t.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <header class="site-header"><a class="mark" href="#inicio" aria-label={t.nav.home}>RG</a><nav aria-label={t.nav.menu}><a href="#proyectos">{t.nav.projects}</a><a href="#practica">{t.nav.practice}</a><a href="#tecnologia">{t.nav.technology}</a><a href="#perfil">{t.nav.profile}</a></nav><div class="header-actions"><a class="language-link" href={alternateLocaleUrl} lang={alternateLang}>{t.nav.language}</a><a class="header-link" href={linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div></header>
    <main>
      <section class="hero" id="inicio" aria-labelledby="page-title">
        <div class="hero-copy"><p>Roger Fernando Guido Cisneros<br />{t.hero.role}</p><h1 id="page-title" aria-label={t.hero.title}><span aria-hidden="true">{t.hero.lineOne}</span><span aria-hidden="true">{t.hero.lineTwo}</span></h1><p class="lead">{t.hero.lead}</p><a class="text-action" href="#proyectos">{t.hero.action} <span aria-hidden="true">↓</span></a></div>
        <div class="hero-graphic" data-ui aria-label={t.flow.label}>
          <svg viewBox="0 0 720 560" preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="flow-title flow-desc"><title id="flow-title">{t.flow.title}</title><desc id="flow-desc">{t.flow.description}</desc><g class="grid-lines"><path d="M0 94H720M0 280H720M0 465H720M112 0V560M360 0V560M608 0V560" /></g><path class="flow-path halo" d="M78 273C153 273 166 127 272 137s94 196 190 168c91-25 77-172 137-153" /><path class="flow-path" d="M78 273C153 273 166 127 272 137s94 196 190 168c91-25 77-172 137-153" /><path class="flow-path soft" d="M78 390c99 0 96 91 194 91 98 0 98-128 190-128 79 0 83 86 137 86" /><circle class="flow-node" cx="78" cy="273" r="34" /><circle class="flow-node mid" cx="272" cy="137" r="45" /><circle class="flow-node light" cx="462" cy="305" r="54" /><circle class="flow-node" cx="599" cy="152" r="34" /><circle class="flow-node light small" cx="272" cy="481" r="25" /><circle class="flow-node mid" cx="599" cy="439" r="40" /><text x="78" y="279">R</text><text x="272" y="144">A</text><text x="462" y="312">UI</text><text x="599" y="158">P</text><text x="272" y="487">QA</text><text x="599" y="445">IA</text><g class="flow-label"><rect x="18" y="319" width="118" height="28" rx="14" /><text x="77" y="338">{t.flow.requirements}</text></g><g class="flow-label"><rect x="201" y="52" width="142" height="28" rx="14" /><text x="272" y="71">{t.flow.analysis}</text></g><g class="flow-label"><rect x="386" y="380" width="152" height="28" rx="14" /><text x="462" y="399">{t.flow.interface}</text></g><g class="flow-label"><rect x="521" y="79" width="156" height="28" rx="14" /><text x="599" y="98">{t.flow.product}</text></g></svg>
        </div>
      </section>

      <section class="projects" id="proyectos" aria-labelledby="projects-title">
        <div class="section-intro"><h2 id="projects-title">{t.projects.title}</h2><p class="section-note">{t.projects.intro}</p></div>
        <article class="case syllabus" data-reveal><div class="case-copy"><p class="case-type">{t.projects.syllabusType}</p><h3>{t.projects.syllabusTitle}</h3><p>{t.projects.syllabusBody}</p><p class="case-impact">{t.projects.syllabusImpact}</p><p class="study-caption">{t.projects.syllabusNote}</p></div><div class="syllabus-stage" data-ui aria-label={demo.syllabusLabel}><div class="browser-demo"><div class="browser-top"><span></span><span></span><span></span><b>Sistema Syllabus</b></div><div class="syllabus-steps"><div class="is-done"><i>1</i><span>{demo.cycle}</span></div><div class="is-active"><i>2</i><span>{demo.analytic}</span></div><div><i>3</i><span>{demo.thematic}</span></div></div><div class="demo-panel"><p>{demo.unit}</p><strong>{demo.definition}</strong><div class="demo-lines"><span></span><span></span><span></span></div><div class="demo-tags"><b>{demo.objectives}</b><b>{demo.contents}</b><b>{demo.sessions}</b></div></div></div><span class="syllabus-orbit one" aria-hidden="true"></span><span class="syllabus-orbit two" aria-hidden="true"></span></div></article>

        <article class="case rental" data-reveal><div class="rental-stage" data-ui aria-label={demo.rentalLabel}><div class="phone-demo"><div class="phone-top"><span>9:41</span><b>{demo.appName}</b><span>●●●</span></div><div class="phone-hero"><span>{demo.nextTrip}</span><strong>{demo.rentClear}</strong></div><div class="phone-tabs"><b>{demo.customers}</b><b class="active">{demo.rentals}</b><b>{demo.cars}</b></div><div class="rental-row"><span class="car-icon">↗</span><div><strong>{demo.activeBooking}</strong><small>{demo.customerFlow}</small></div><b>{demo.active}</b></div><div class="rental-row"><span class="car-icon">○</span><div><strong>{demo.availability}</strong><small>{demo.lookup}</small></div><b>{demo.ready}</b></div></div><span class="rental-disc disc-one" aria-hidden="true"></span><span class="rental-disc disc-two" aria-hidden="true"></span></div><div class="case-copy"><p class="case-type">{t.projects.rentalType}</p><h3>{t.projects.rentalTitle}</h3><p>{t.projects.rentalBody}</p><p class="case-impact">{t.projects.rentalImpact}</p><p class="study-caption">{t.projects.rentalNote}</p></div></article>

        <article class="case freelance" data-reveal><div class="case-copy"><p class="case-type">{t.projects.freelanceType}</p><h3>{t.projects.freelanceTitle}</h3><p>{t.projects.freelanceBody}</p><p class="study-caption">{t.projects.freelanceNote}</p></div><div class="journey-demo" data-ui aria-label={demo.journeyLabel}><div class="journey-title"><span>{demo.experience}</span><b>{demo.clearRoute}</b></div><ol><li class="done"><i></i><div><b>{demo.access}</b><span>{demo.entry}</span></div></li><li class="active"><i></i><div><b>{demo.questionnaire}</b><span>{demo.progress}</span></div></li><li><i></i><div><b>{demo.result}</b><span>{demo.actionable}</span></div></li><li><i></i><div><b>{demo.content}</b><span>{demo.continuity}</span></div></li></ol><div class="journey-footer">{demo.footer}</div></div></article>
      </section>

      <section class="practice" id="practica" aria-labelledby="practice-title" data-reveal><div class="practice-copy"><p class="case-type">{t.practice.eyebrow}</p><h2 id="practice-title">{t.practice.title}</h2><p>{t.practice.bodyOne}</p><p>{t.practice.bodyTwo}</p><p class="study-caption">{t.practice.note}</p></div><div class="practice-map" data-ui aria-label={t.practice.label}><div class="map-core"><span set:html={t.practice.core} /></div><span class="map-node one">{t.practice.requirements}</span><span class="map-node two">{t.practice.interfaces}</span><span class="map-node three">{t.practice.testing}</span><span class="map-node four">{t.practice.components}</span><svg viewBox="0 0 520 360" aria-hidden="true"><path d="M260 178C189 130 148 113 102 78M260 178c78-45 110-50 157-89M260 178c-57 45-90 66-126 121M260 178c68 42 105 67 157 103" /></svg></div></section>

      <section class="technology" id="tecnologia" aria-labelledby="technology-title"><div><h2 id="technology-title">{t.technology.title}</h2><p>{t.technology.body}</p><span class="rail-hint">{t.technology.hint}</span></div><div class="tech-rail" data-ui tabindex="0" aria-label={t.technology.label}><div class="tech-track"><ul>{technologies.map((technology) => <li style={`--brand:#${technology.icon.hex}`}><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d={technology.icon.path} /></svg></span><b>{technology.name}</b></li>)}</ul><ul aria-hidden="true">{technologies.map((technology) => <li style={`--brand:#${technology.icon.hex}`}><span><svg viewBox="0 0 24 24"><path d={technology.icon.path} /></svg></span><b>{technology.name}</b></li>)}</ul></div></div></section>

      <section class="profile" id="perfil" data-reveal><p>{t.profile.first}</p><p>{t.profile.second}</p></section>

      <section class="contact" aria-labelledby="contact-title"><div class="contact-flow" aria-hidden="true"><svg viewBox="0 0 660 270"><path d="M0 145C88 145 101 64 198 64s89 142 178 142S455 87 543 87s72 57 117 57" /><circle cx="198" cy="64" r="16" /><circle cx="376" cy="206" r="24" /><circle cx="543" cy="87" r="16" /></svg></div><div><h2 id="contact-title">{t.contact.title}</h2><p>{t.contact.body}</p><div class="contact-links" data-ui><a href={github} target="_blank" rel="noreferrer"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>GitHub</span><i aria-hidden="true">↗</i></a><a href={linkedin} target="_blank" rel="noreferrer"><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={linkedinIcon.path} /></svg>LinkedIn</span><i aria-hidden="true">↗</i></a></div></div></section>
    </main>
    <footer><span>Roger Fernando Guido Cisneros</span><span>{t.footer}</span></footer>
    <script>
      document.documentElement.classList.add("js");
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) document.querySelectorAll("[data-reveal]").forEach((element) => element.classList.add("is-in"));
      else { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-in"); observer.unobserve(entry.target); } }), { threshold: 0.12 }); document.querySelectorAll("[data-reveal]").forEach((element) => observer.observe(element)); }
    </script>
    <style>
      :global(:root){--paper:#f6f9ff;--surface:#eaf3ff;--surface-deep:#d7e8ff;--ink:#112b52;--muted:#547093;--blue:#256dd3;--blue-deep:#124caa;--cyan:#62b8ed;--white:#fff;--page:clamp(1.1rem,4vw,4.5rem);--ease:cubic-bezier(.16,1,.3,1)}:global(*){box-sizing:border-box}:global(html){background:var(--paper);scroll-behavior:smooth}:global(body){margin:0;background:var(--paper);color:var(--ink);font-family:"Chivo Variable",Chivo,sans-serif;font-size:16px;overflow-x:hidden}:global(a){color:inherit;text-underline-offset:.2em;text-decoration-thickness:.08em}:global(a:focus-visible){outline:3px solid var(--cyan);outline-offset:5px}:global(::selection){background:var(--blue);color:var(--white)}:global(svg){display:block}.site-header{position:absolute;z-index:2;width:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:1.3rem var(--page);font-size:.9rem}.mark{font-size:1.2rem;font-weight:800;letter-spacing:-.1em;text-decoration:none}.site-header nav{display:flex;gap:1.4rem}.header-actions{justify-self:end;display:flex;align-items:center;gap:1rem}.language-link{display:grid;place-items:center;width:2.15rem;height:2.15rem;border:0;border-radius:50%;background:#dbeeff;color:var(--blue-deep);font-size:.76rem;font-weight:800;text-decoration:none}.site-header nav a,.header-link{text-decoration:none}.header-link{justify-self:end}.site-header a:hover{color:var(--blue)}
      .hero{min-height:100svh;padding:clamp(6.5rem,12vw,10rem) var(--page) 2rem;display:grid;grid-template-columns:minmax(0,.95fr) minmax(23rem,1.05fr);align-items:center;gap:clamp(2rem,8vw,11rem);background:var(--paper)}.hero-copy>p:first-child,.case-type{margin:0;color:var(--muted);font-size:.9rem;line-height:1.45}.hero h1{max-width:10ch;margin:1.5rem 0 0;font-size:clamp(3.6rem,7vw,6rem);letter-spacing:-.055em;line-height:.89}.hero h1 span{display:block;overflow:hidden;animation:line-up 800ms var(--ease) both}.hero h1 span+span{animation-delay:90ms}.lead{max-width:34rem;margin:1.8rem 0 0;font-size:clamp(1.08rem,1.4vw,1.3rem);line-height:1.5}.text-action{display:inline-flex;gap:.8rem;margin-top:2rem;color:var(--blue);font-weight:750}.hero-graphic{position:relative;aspect-ratio:720/560;min-height:0;overflow:hidden;background:#dceeff;box-shadow:inset 0 0 0 1px rgba(18,76,170,.08),0 30px 70px rgba(18,76,170,.15)}.hero-graphic::before,.hero-graphic::after{content:"";position:absolute;border-radius:50%;pointer-events:none}.hero-graphic::before{width:15rem;height:15rem;right:-5rem;top:-5rem;background:#9ed0ff;filter:blur(10px);opacity:.72}.hero-graphic::after{width:11rem;height:11rem;left:-5rem;bottom:-5rem;background:#a8e0ec;filter:blur(12px);opacity:.65}.hero-graphic svg{position:absolute;inset:0;z-index:1;width:100%;height:100%}.grid-lines path{fill:none;stroke:#5a90cb;stroke-width:1;opacity:.22}.flow-path{fill:none;stroke:var(--blue);stroke-width:3;stroke-linecap:round;stroke-dasharray:8 12}.flow-path.halo{stroke:#fff;stroke-width:11;stroke-dasharray:none;opacity:.72}.flow-path.soft{stroke:var(--cyan);stroke-width:2}.flow-node{fill:var(--blue);stroke:var(--paper);stroke-width:9}.flow-node.mid{fill:var(--cyan)}.flow-node.light{fill:var(--white);stroke:var(--blue);stroke-width:5}.flow-node.small{stroke-width:4}.hero-graphic>svg>text{fill:var(--ink);font:700 18px "Chivo Variable",sans-serif;text-anchor:middle}.flow-label rect{fill:#fff;filter:drop-shadow(0 5px 7px rgba(17,43,82,.12))}.flow-label text{fill:var(--blue-deep);font:800 9px "Chivo Variable",sans-serif;letter-spacing:.05em;text-anchor:middle}
      .projects{position:relative;padding:clamp(7rem,13vw,12rem) var(--page);overflow:hidden;background:var(--white)}.projects::before{content:"";position:absolute;width:24rem;height:24rem;right:-13rem;top:30rem;border:1px solid #c8e0ff;border-radius:50%;box-shadow:0 0 0 2.6rem #f6faff,0 0 0 2.7rem #dbeeff}.section-intro{position:relative;z-index:1;display:grid;grid-template-columns:minmax(12rem,.85fr) 1fr;gap:clamp(2rem,10vw,11rem);margin-bottom:clamp(4rem,8vw,8rem)}.section-intro .section-note{max-width:38ch;padding-left:1.25rem;border-left:3px solid var(--cyan)}.section-intro h2,.technology h2,.contact h2,.practice h2{max-width:10ch;margin:0;font-size:clamp(2.7rem,5.1vw,5.4rem);letter-spacing:-.055em;line-height:.9}.section-intro p{max-width:38ch;margin:0;color:var(--ink);font-size:clamp(1.14rem,1.65vw,1.48rem);font-weight:580;line-height:1.5}.case{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,9rem);align-items:center;padding:clamp(4.5rem,9vw,8rem) 0}.case+.case{background:var(--paper);margin-inline:calc(var(--page) * -1);padding-inline:var(--page)}.case-copy h3{max-width:15ch;margin:1rem 0 1.4rem;font-size:clamp(2rem,3.6vw,4rem);letter-spacing:-.05em;line-height:.95}.case-copy p:not(.case-type){max-width:46ch;margin:0;color:var(--muted);line-height:1.55}.case-copy .case-impact{margin-top:1rem;color:var(--ink);font-weight:650}.study-caption{max-width:36ch!important;margin-top:1.5rem!important;padding-left:.9rem;border-left:2px solid var(--cyan);font-size:.84rem;font-style:italic}.syllabus-stage{position:relative;display:grid;place-items:center;min-height:35rem;isolation:isolate}.syllabus-stage::before{content:"";position:absolute;z-index:-1;width:21rem;height:21rem;background:#e2f3e5;border-radius:50%;filter:blur(1px)}.browser-demo{width:min(100%,31rem);min-height:31rem;overflow:hidden;background:var(--white);border:1px solid rgba(12,73,117,.14);border-radius:1.45rem;box-shadow:0 28px 66px rgba(12,73,117,.24),0 5px 0 rgba(35,137,55,.13);transform:rotate(-2deg)}.browser-top{height:3.3rem;display:flex;align-items:center;gap:.35rem;padding:0 1rem;background:#0c4975;color:var(--white);font-size:.85rem}.browser-top span{width:.55rem;height:.55rem;border-radius:50%;background:#73d1b3}.browser-top b{margin-left:.65rem}.syllabus-steps{display:flex;justify-content:space-between;gap:.4rem;padding:1.6rem 1.1rem 1.1rem}.syllabus-steps div{display:grid;justify-items:center;gap:.4rem;flex:1;color:var(--muted);font-size:.7rem;text-align:center}.syllabus-steps i{display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:#e3f2eb;color:#0c4975;font-style:normal;font-weight:800}.syllabus-steps .is-done i{background:#238937;color:var(--white)}.syllabus-steps .is-active i{background:#0f5d96;color:var(--white)}.demo-panel{margin:0 1.1rem 1.1rem;padding:1.35rem;background:#eaf5f1}.demo-panel p{margin:0;color:#386478;font-size:.8rem}.demo-panel strong{display:block;margin-top:.45rem;font-size:1.15rem}.demo-lines{display:grid;gap:.45rem;margin-top:1.4rem}.demo-lines span{height:.55rem;background:var(--white)}.demo-lines span:nth-child(2){width:77%}.demo-tags{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:1.4rem}.demo-tags b{padding:.35rem .55rem;background:var(--white);color:#238937;font-size:.72rem}.syllabus-orbit{position:absolute;z-index:-1;border:1px solid #77c99a;border-radius:50%}.syllabus-orbit.one{width:30rem;height:12rem;transform:rotate(52deg)}.syllabus-orbit.two{width:24rem;height:24rem;border-color:#98c7e6;transform:rotate(-18deg)}.rental-stage{position:relative;display:grid;place-items:center;min-height:35rem;isolation:isolate}.rental-stage::before{content:"";position:absolute;z-index:-1;width:23rem;height:23rem;border-radius:50%;background:#c7e8ff;filter:blur(2px)}.phone-demo{position:relative;width:min(100%,20rem);padding:.7rem;background:var(--ink);border:8px solid #fff;border-radius:2.35rem;box-shadow:0 35px 60px rgba(17,43,82,.3),0 8px 22px rgba(37,109,211,.22)